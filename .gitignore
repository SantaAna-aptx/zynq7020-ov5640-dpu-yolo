dpu_trd/
sdcard/
web/
bd_probe/
soc_prj.gen/
vivado_session/
petalinux_projects/

# Xilinx 专有 IP 源码（CONFIDENTIAL IN CONFIDENCE），连同探测工程一起排除
probe_src/

